{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "reading-time-wp/reading-time",
	"version": "3.0.0",
	"title": "Reading Time",
	"category": "widgets",
	"icon": "clock",
	"description": "Display estimated reading time for the current post.",
	"keywords": ["reading", "time", "estimate"],
	"textdomain": "reading-time-wp",
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"postfix": {
			"type": "string",
			"default": ""
		},
		"postfixSingular": {
			"type": "string",
			"default": ""
		},
		"textAlign": {
			"type": "string"
		},
		"fontSize": {
			"type": "string"
		},
		"customFontSize": {
			"type": "number"
		},
		"textColor": {
			"type": "string"
		},
		"customTextColor": {
			"type": "string"
		},
		"backgroundColor": {
			"type": "string"
		},
		"customBackgroundColor": {
			"type": "string"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
